{
  "name": "nengyong-bot",
  "private": true,
  "version": "1.0.0-beta.3",
  "description": "A team of AI assistants on your desktop: the main bot takes the work and hands it out, every other bot owns one job",
  "author": {
    "name": "Zhu Kunpeng",
    "url": "https://github.com/zhukunpenglinyutong"
  },
  "homepage": "https://github.com/zhukunpenglinyutong/nengyong-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhukunpenglinyutong/nengyong-bot.git"
  },
  "bugs": {
    "url": "https://github.com/zhukunpenglinyutong/nengyong-bot/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "biome check && tsc -b && vitest run",
    "app": "node scripts/dev.mjs",
    "app:prod": "vite build && vite build -c vite.electron.config.ts && electron .",
    "dist:mac": "npm run build && vite build -c vite.electron.config.ts && electron-builder --mac --publish never",
    "dist:win": "npm run build && vite build -c vite.electron.config.ts && electron-builder --win --publish never",
    "dist:linux": "npm run build && vite build -c vite.electron.config.ts && electron-builder --linux --publish never",
    "format": "biome check --write"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.88",
    "@ai-sdk/mcp": "^2.0.101",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "ai": "^7.0.176",
    "croner": "^11.0.1",
    "electron-updater": "^6.8.11",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.4",
    "remark-gfm": "^4.0.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "electron@45.3.4": true
  },
  "main": "dist-electron/main.cjs",
  "desktopName": "nengyong-bot.desktop"
}
